<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PnpFrameworkProject Condition="'$(PnpFrameworkProject)' == ''">../../../src/lib/PnP.Framework/PnP.Framework.csproj</PnpFrameworkProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ccd263-runtime-browser.csproj" AdditionalProperties="PnpFrameworkProject=$(PnpFrameworkProject)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../fixtures/*.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
