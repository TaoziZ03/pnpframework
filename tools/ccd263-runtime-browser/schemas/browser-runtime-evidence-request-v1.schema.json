{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccd272.browser-runtime-evidence-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bindingPath",
    "artifactStorePath",
    "outputPath",
    "expected",
    "captureProducer",
    "startedAtUtc",
    "completedAtUtc",
    "observedTargetIdentity",
    "preCaptureTargetReadback",
    "postCaptureTargetReadback",
    "attempts",
    "browserContext",
    "results",
    "terminalObservation",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "ccd272.browser-runtime-evidence-request/v1" },
    "bindingPath": { "$ref": "#/$defs/path" },
    "artifactStorePath": { "$ref": "#/$defs/path" },
    "outputPath": { "$ref": "#/$defs/path" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingDigestSha256",
        "sourceVersionDigestSha256",
        "admittedPlanDigestSha256",
        "importReceiptDigestSha256",
        "runtimeOperationId",
        "targetFileUniqueId",
        "targetListItemId",
        "targetListItemVersion",
        "targetCanonicalUrl"
      ],
      "properties": {
        "bindingDigestSha256": { "$ref": "#/$defs/sha256" },
        "sourceVersionDigestSha256": { "$ref": "#/$defs/sha256" },
        "admittedPlanDigestSha256": { "$ref": "#/$defs/sha256" },
        "importReceiptDigestSha256": { "$ref": "#/$defs/sha256" },
        "runtimeOperationId": { "$ref": "#/$defs/guid" },
        "targetFileUniqueId": { "$ref": "#/$defs/guid" },
        "targetListItemId": { "type": "integer", "minimum": 1 },
        "targetListItemVersion": { "type": "string", "minLength": 1 },
        "targetCanonicalUrl": { "type": "string", "format": "uri" }
      }
    },
    "captureProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterId", "version", "implementationRef", "toolVersion", "protocolVersion"],
      "properties": {
        "adapterId": { "const": "ccd272.browser-runtime-adapter" },
        "version": { "const": "1.0.0" },
        "implementationRef": { "$ref": "#/$defs/gitRef" },
        "toolVersion": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": "string", "minLength": 1 }
      }
    },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": { "type": "string", "format": "date-time" },
    "observedTargetIdentity": { "type": "object" },
    "preCaptureTargetReadback": { "type": "object" },
    "postCaptureTargetReadback": { "type": "object" },
    "attempts": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object" } },
    "browserContext": { "type": ["object", "null"] },
    "results": { "type": "array", "items": { "type": "object" } },
    "terminalObservation": { "type": ["object", "null"] },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[^.]+\\..+$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "oneOf": [
    {
      "properties": {
        "browserContext": { "type": "object" },
        "results": { "type": "array", "minItems": 1 },
        "terminalObservation": { "type": "null" }
      }
    },
    {
      "properties": {
        "browserContext": { "type": "null" },
        "results": { "type": "array", "maxItems": 0 },
        "terminalObservation": { "type": "object" }
      }
    }
  ],
  "$defs": {
    "path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "gitRef": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "guid": {
      "type": "string",
      "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
