<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unbound</SourceRevisionId>
    <InformationalVersion>1.0.0+$(SourceRevisionId)</InformationalVersion>
    <PnpFrameworkProject Condition="'$(PnpFrameworkProject)' == ''">../../src/lib/PnP.Framework/PnP.Framework.csproj</PnpFrameworkProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PnpFrameworkProject)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
