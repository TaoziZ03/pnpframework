{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccd153.native-runtime-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "caseId", "profileId", "implementationRef", "packagePath", "admittedPlanPath", "receiptAggregatePath", "bindingPath", "artifactStorePath", "producerBuildManifestPath", "verificationJournalPath", "outputDirectory"],
  "properties": {
    "schema": { "const": "ccd153.native-runtime-request/v1" },
    "caseId": { "type": "string", "minLength": 1 },
    "profileId": { "const": "classic-wiki.synthetic.runtime-acceptance/v1" },
    "implementationRef": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "packagePath": { "$ref": "#/$defs/path" },
    "admittedPlanPath": { "$ref": "#/$defs/path" },
    "receiptAggregatePath": { "$ref": "#/$defs/path" },
    "bindingPath": { "$ref": "#/$defs/path" },
    "externalEvidencePath": { "type": ["string", "null"] },
    "artifactStorePath": { "$ref": "#/$defs/path" },
    "producerBuildManifestPath": { "$ref": "#/$defs/path" },
    "verificationJournalPath": { "$ref": "#/$defs/path" },
    "outputDirectory": { "$ref": "#/$defs/path" },
    "evaluatedAtUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": { "path": { "type": "string", "minLength": 1 } }
}
