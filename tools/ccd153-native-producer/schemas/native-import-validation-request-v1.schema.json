{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccd153.native-import-validation-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "caseId",
    "implementationRef",
    "admittedPlanPath"
  ],
  "oneOf": [
    { "required": ["importReceiptPath"], "not": { "required": ["receiptAggregatePath"] } },
    { "required": ["receiptAggregatePath"], "not": { "required": ["importReceiptPath"] } }
  ],
  "properties": {
    "schema": { "const": "ccd153.native-import-validation-request/v1" },
    "caseId": { "type": "string", "minLength": 1 },
    "implementationRef": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "pageFamily": { "enum": ["publishing", "classic-wiki"] },
    "admittedPlanPath": { "type": "string", "minLength": 1 },
    "importReceiptPath": { "type": "string", "minLength": 1 },
    "receiptAggregatePath": { "type": "string", "minLength": 1 }
  }
}
