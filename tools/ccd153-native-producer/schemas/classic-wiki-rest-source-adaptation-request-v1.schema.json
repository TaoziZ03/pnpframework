{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccd153.classic-wiki-rest-source-adaptation-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "caseId",
    "implementationRef",
    "packagePath",
    "admittedPlanPath",
    "outputDirectory"
  ],
  "properties": {
    "schema": {
      "const": "ccd153.classic-wiki-rest-source-adaptation-request/v1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "implementationRef": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1
    },
    "admittedPlanPath": {
      "type": "string",
      "minLength": 1
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1
    }
  }
}
