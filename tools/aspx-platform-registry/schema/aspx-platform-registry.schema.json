{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccd:pnp:aspx-platform-registry:v1",
  "title": "SharePoint setup and virtual ASPX platform registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registrySchemaVersion",
    "registryRevision",
    "registryHash",
    "authorityKind",
    "authoritySourceRef",
    "authorityArtifactHash",
    "reviewRef",
    "platformFamily",
    "platformBuildMin",
    "platformBuildMax",
    "normalization",
    "failureSemantics",
    "applicabilityRules",
    "consumerCompatibility",
    "entryCount",
    "entries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "registrySchemaVersion": { "const": "aspx-platform-registry/v1" },
    "registryRevision": { "type": "string", "minLength": 1 },
    "registryHash": { "$ref": "#/$defs/sha256" },
    "authorityKind": { "const": "SPOCoreReleaseShippingManifest" },
    "authoritySourceRef": { "$ref": "#/$defs/gitSha" },
    "authoritySourceTag": { "type": "string", "minLength": 1 },
    "authorityArtifactHash": { "$ref": "#/$defs/sha256" },
    "authorityArtifactPath": { "type": "string", "minLength": 1 },
    "reviewRef": { "type": "string", "minLength": 1 },
    "contractReviewRef": { "type": "string", "minLength": 1 },
    "compatibilityDecisionRef": { "type": "string", "minLength": 1 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "platformFamily": { "type": "string", "minLength": 1 },
    "platformBuildMin": { "$ref": "#/$defs/platformBuild" },
    "platformBuildMax": { "$ref": "#/$defs/platformBuild" },
    "normalization": { "type": "object" },
    "failureSemantics": {
      "type": "object",
      "additionalProperties": { "const": "Unknown" }
    },
    "applicabilityRules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/applicabilityRule" }
    },
    "consumerCompatibility": { "$ref": "#/$defs/consumerCompatibility" },
    "entryCount": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platformBuild": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "disposition": {
      "enum": [
        "ReferenceOnlyAvailable",
        "ReferenceUnavailable",
        "LinkedPhysicalGhosted",
        "LinkedPhysicalCustomized",
        "VirtualHandler",
        "NonAspx",
        "Unknown"
      ]
    },
    "applicabilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicabilityRuleId",
        "applicabilityRuleVersion",
        "applicabilityRuleHash",
        "reviewRef",
        "definition"
      ],
      "properties": {
        "applicabilityRuleId": { "type": "string", "minLength": 1 },
        "applicabilityRuleVersion": { "type": "string", "minLength": 1 },
        "applicabilityRuleHash": { "$ref": "#/$defs/sha256" },
        "reviewRef": { "type": "string", "minLength": 1 },
        "definition": { "type": "object" }
      }
    },
    "physicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageIdentity", "fileUniqueId", "physicalLocator"],
      "properties": {
        "storageIdentity": {
          "enum": ["PhysicalSPFile", "NoPhysicalFile", "Denied", "Missing", "Unknown"]
        },
        "fileUniqueId": { "type": ["string", "null"] },
        "physicalLocator": { "type": ["string", "null"] }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceId",
        "surfaceKind",
        "canonicalRequestPath",
        "aliases",
        "aliasPatterns",
        "handlerOrArtifactType",
        "applicabilityRuleId",
        "applicabilityRuleHash",
        "expectedAvailability",
        "downstreamDisposition",
        "identityAxes",
        "physicalIdentity",
        "contentOrigin"
      ],
      "properties": {
        "referenceId": { "type": "string", "pattern": "^spo-layouts-[0-9a-f]{32}$" },
        "surfaceKind": {
          "enum": ["SetupLayoutApplicationPage", "VirtualMappedRequest"]
        },
        "canonicalRequestPath": {
          "type": "string",
          "pattern": "^/_layouts/15/.+\\.aspx$"
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/_layouts/.+\\.aspx$" }
        },
        "aliasPatterns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "handlerOrArtifactType": {
          "enum": [
            "SetupArtifact.AspxApplicationPage",
            "VirtualHandler.SPLayoutsMappedFile"
          ]
        },
        "applicabilityRuleId": { "type": "string", "minLength": 1 },
        "applicabilityRuleHash": { "$ref": "#/$defs/sha256" },
        "expectedAvailability": {
          "enum": [
            "AvailableForExactPlatformBuild",
            "ReferenceTargetAbsentAtFrozenBuild"
          ]
        },
        "downstreamDisposition": { "$ref": "#/$defs/disposition" },
        "identityAxes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestReferenceIdentity",
            "setupArtifactIdentity",
            "virtualHandlerIdentity",
            "ghostedPhysicalFileIdentity"
          ],
          "properties": {
            "requestReferenceIdentity": { "type": "object" },
            "setupArtifactIdentity": { "type": ["object", "null"] },
            "virtualHandlerIdentity": { "type": ["object", "null"] },
            "ghostedPhysicalFileIdentity": { "type": ["object", "null"] }
          }
        },
        "physicalIdentity": { "$ref": "#/$defs/physicalIdentity" },
        "contentOrigin": {
          "enum": [
            "ContentDatabaseCustomized",
            "ContentDatabaseGhosted",
            "SetupArtifact",
            "VirtualHandler",
            "Unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "downstreamDisposition": {
                "enum": [
                  "ReferenceOnlyAvailable",
                  "ReferenceUnavailable",
                  "VirtualHandler"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "physicalIdentity": {
                "properties": {
                  "fileUniqueId": { "type": "null" },
                  "physicalLocator": { "type": "null" }
                }
              }
            }
          }
        }
      ]
    },
    "consumerCompatibility": {
      "type": "object",
      "required": ["compatibilityDecisionRef", "sourceKinds", "dispositions", "volumeCompatibility"],
      "properties": {
        "compatibilityDecisionRef": { "type": "string" },
        "sourceKinds": {
          "type": "array",
          "contains": { "const": "PlatformRegistryReference" }
        },
        "dispositions": {
          "type": "object",
          "required": [
            "ReferenceOnlyAvailable",
            "ReferenceUnavailable",
            "LinkedPhysicalGhosted",
            "LinkedPhysicalCustomized",
            "VirtualHandler",
            "NonAspx",
            "Unknown"
          ]
        },
        "volumeCompatibility": { "type": "object" }
      }
    }
  }
}
