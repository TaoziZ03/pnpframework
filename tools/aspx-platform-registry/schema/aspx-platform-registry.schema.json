{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccd:pnp:aspx-platform-registry:spo-online-16.0.27606.12000:r3",
  "title": "SharePoint setup and virtual ASPX platform registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "registrySchemaVersion",
    "registryRevision",
    "registryHash",
    "authorityKind",
    "authoritySourceRef",
    "authoritySourceTag",
    "authorityArtifactHash",
    "authorityArtifactPath",
    "reviewRef",
    "contractReviewRef",
    "compatibilityDecisionRef",
    "generatedAtUtc",
    "platformFamily",
    "platformBuildMin",
    "platformBuildMax",
    "normalization",
    "failureSemantics",
    "applicabilityRules",
    "consumerCompatibility",
    "entryCount",
    "entries"
  ],
  "properties": {
    "$schema": { "const": "../schema/aspx-platform-registry.schema.json" },
    "registrySchemaVersion": { "const": "aspx-platform-registry/v1" },
    "registryRevision": { "const": "spo-online-16.0.27606.12000-r3" },
    "registryHash": { "$ref": "#/$defs/sha256" },
    "authorityKind": { "const": "SPOCoreReleaseShippingManifest" },
    "authoritySourceRef": { "const": "cee0ed61136e17c742c1cf98c9dea9446f10c564" },
    "authoritySourceTag": { "const": "release/16.0.27606.12000" },
    "authorityArtifactHash": { "$ref": "#/$defs/sha256" },
    "authorityArtifactPath": { "const": "authority/spo-online-16.0.27606.12000.authority.json" },
    "reviewRef": { "type": "string", "minLength": 1 },
    "contractReviewRef": {
      "const": "CCD-394#document-aspx-surface-applicability-denominator-v3@7d44f61d-919e-478a-ab8e-bb4c8f9b4b4a"
    },
    "compatibilityDecisionRef": { "const": "CCD-411:approve_with_changes" },
    "generatedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "platformFamily": { "const": "SharePointOnline-16" },
    "platformBuildMin": { "const": "16.0.27606.12000" },
    "platformBuildMax": { "const": "16.0.27606.12000" },
    "normalization": { "type": "object", "minProperties": 1 },
    "failureSemantics": { "$ref": "#/$defs/failureSemantics" },
    "applicabilityRules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/applicabilityRule" }
    },
    "consumerCompatibility": { "$ref": "#/$defs/consumerCompatibility" },
    "entryCount": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "disposition": {
      "enum": [
        "ReferenceOnlyAvailable",
        "ReferenceUnavailable",
        "LinkedPhysicalGhosted",
        "LinkedPhysicalCustomized",
        "VirtualHandler",
        "NonAspx",
        "Unknown"
      ]
    },
    "failureSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownBuild",
        "missingRegistryVolume",
        "registryProfileMismatch",
        "sameRevisionChangedHash",
        "aliasCollision",
        "runtimePathAbsent",
        "unknownSourceKindOrDisposition",
        "missingAcquisitionEnvelope",
        "missingPhysicalVolume",
        "missingReferenceVolume",
        "unsupportedOutputVersion",
        "unsupportedContractVersion",
        "unsupportedStoreVersion",
        "missingArtifactEvidence",
        "volumeHashMismatch",
        "volumeLengthMismatch",
        "volumeContentMismatch",
        "storeIntegrityFailure",
        "storeSchemaMismatch",
        "storeManifestMismatch",
        "volumeRefMismatch",
        "volumeFenceMismatch",
        "volumeBuildMismatch",
        "bindingMismatch"
      ],
      "properties": {
        "unknownBuild": { "const": "Unknown" },
        "missingRegistryVolume": { "const": "Unknown" },
        "registryProfileMismatch": { "const": "Unknown" },
        "sameRevisionChangedHash": { "const": "Unknown" },
        "aliasCollision": { "const": "Unknown" },
        "runtimePathAbsent": { "const": "Unknown" },
        "unknownSourceKindOrDisposition": { "const": "Unknown" },
        "missingAcquisitionEnvelope": { "const": "Unknown" },
        "missingPhysicalVolume": { "const": "Unknown" },
        "missingReferenceVolume": { "const": "Unknown" },
        "unsupportedOutputVersion": { "const": "Unknown" },
        "unsupportedContractVersion": { "const": "Unknown" },
        "unsupportedStoreVersion": { "const": "Unknown" },
        "missingArtifactEvidence": { "const": "Unknown" },
        "volumeHashMismatch": { "const": "Unknown" },
        "volumeLengthMismatch": { "const": "Unknown" },
        "volumeContentMismatch": { "const": "Unknown" },
        "storeIntegrityFailure": { "const": "Unknown" },
        "storeSchemaMismatch": { "const": "Unknown" },
        "storeManifestMismatch": { "const": "Unknown" },
        "volumeRefMismatch": { "const": "Unknown" },
        "volumeFenceMismatch": { "const": "Unknown" },
        "volumeBuildMismatch": { "const": "Unknown" },
        "bindingMismatch": { "const": "Unknown" }
      }
    },
    "sourceKinds": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "const": "ListFormReference" },
        { "const": "ListViewReference" },
        { "const": "WebWelcomePageReference" },
        { "const": "PlatformRegistryReference" },
        { "const": "RuntimeRequestReference" }
      ],
      "items": false
    },
    "volumeCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalOutput",
        "physicalContract",
        "physicalStore",
        "referenceOutput",
        "referenceContract",
        "referenceStore",
        "aggregateOutput"
      ],
      "properties": {
        "physicalOutput": { "const": "aspx-discovery-output/v2" },
        "physicalContract": { "const": "aspx-discovery/v2" },
        "physicalStore": { "const": "aspx-discovery-sqlite/v2" },
        "referenceOutput": { "const": "aspx-reference-output/v1" },
        "referenceContract": { "const": "aspx-reference/v1" },
        "referenceStore": { "const": "aspx-reference-sqlite/v1" },
        "aggregateOutput": { "const": "aspx-acquisition-verdict/v1" }
      }
    },
    "consumerMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "pnpGraph", "repro", "compare"],
      "properties": {
        "assessment": { "type": "string", "minLength": 1 },
        "pnpGraph": { "type": "string", "minLength": 1 },
        "repro": { "type": "string", "minLength": 1 },
        "compare": { "type": "string", "minLength": 1 }
      }
    },
    "artifactVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actualOutputBytes",
        "actualOutputLength",
        "jsonOutputVersion",
        "acquisitionRunId",
        "sqliteIntegrityCheck",
        "sqliteSchemaManifestAlgorithm",
        "physicalStoreSchemaHash",
        "referenceStoreSchemaHash",
        "sqliteRunManifestHash"
      ],
      "properties": {
        "actualOutputBytes": { "const": "Required" },
        "actualOutputLength": { "const": "Required" },
        "jsonOutputVersion": { "const": "Exact" },
        "acquisitionRunId": { "const": "Exact" },
        "sqliteIntegrityCheck": { "const": "Required" },
        "sqliteSchemaManifestAlgorithm": { "const": "sqlite-schema-manifest/v1" },
        "physicalStoreSchemaHash": { "const": "d346ebbf2a8cbd25c0babae543e2fc6a4dd234a171df83973c6624b1eb65fda2" },
        "referenceStoreSchemaHash": { "const": "7470d1e964f202978c9628a0425b3fe1860fd1384d6a2cead35cbd3a0b17e57d" },
        "sqliteRunManifestHash": { "const": "Required" }
      }
    },
    "consumerCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibilityDecisionRef",
        "recordKind",
        "sourceKinds",
        "dispositions",
        "volumeCompatibility",
        "artifactVerification"
      ],
      "properties": {
        "compatibilityDecisionRef": { "const": "CCD-411:approve_with_changes" },
        "recordKind": { "const": "AspxReferenceObservation" },
        "sourceKinds": { "$ref": "#/$defs/sourceKinds" },
        "dispositions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ReferenceOnlyAvailable",
            "ReferenceUnavailable",
            "LinkedPhysicalGhosted",
            "LinkedPhysicalCustomized",
            "VirtualHandler",
            "NonAspx",
            "Unknown"
          ],
          "properties": {
            "ReferenceOnlyAvailable": { "$ref": "#/$defs/consumerMapping" },
            "ReferenceUnavailable": { "$ref": "#/$defs/consumerMapping" },
            "LinkedPhysicalGhosted": { "$ref": "#/$defs/consumerMapping" },
            "LinkedPhysicalCustomized": { "$ref": "#/$defs/consumerMapping" },
            "VirtualHandler": { "$ref": "#/$defs/consumerMapping" },
            "NonAspx": { "$ref": "#/$defs/consumerMapping" },
            "Unknown": { "$ref": "#/$defs/consumerMapping" }
          }
        },
        "volumeCompatibility": { "$ref": "#/$defs/volumeCompatibility" },
        "artifactVerification": { "$ref": "#/$defs/artifactVerification" }
      }
    },
    "applicabilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicabilityRuleId",
        "applicabilityRuleVersion",
        "applicabilityRuleHash",
        "reviewRef",
        "definition"
      ],
      "properties": {
        "applicabilityRuleId": { "type": "string", "minLength": 1 },
        "applicabilityRuleVersion": { "type": "string", "minLength": 1 },
        "applicabilityRuleHash": { "$ref": "#/$defs/sha256" },
        "reviewRef": { "type": "string", "minLength": 1 },
        "definition": { "type": "object" }
      }
    },
    "physicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageIdentity", "fileUniqueId", "physicalLocator"],
      "properties": {
        "storageIdentity": {
          "enum": ["PhysicalSPFile", "NoPhysicalFile", "Denied", "Missing", "Unknown"]
        },
        "fileUniqueId": { "type": ["string", "null"] },
        "physicalLocator": { "type": ["string", "null"] }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceId",
        "surfaceKind",
        "canonicalRequestPath",
        "aliases",
        "aliasPatterns",
        "handlerOrArtifactType",
        "applicabilityRuleId",
        "applicabilityRuleHash",
        "expectedAvailability",
        "downstreamDisposition",
        "identityAxes",
        "physicalIdentity",
        "contentOrigin"
      ],
      "properties": {
        "referenceId": { "type": "string", "pattern": "^spo-layouts-[0-9a-f]{32}$" },
        "surfaceKind": { "enum": ["SetupLayoutApplicationPage", "VirtualMappedRequest"] },
        "canonicalRequestPath": { "type": "string", "pattern": "^/_layouts/15/.+\\.aspx$" },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/_layouts/.+\\.aspx$" }
        },
        "aliasPatterns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "handlerOrArtifactType": {
          "enum": ["SetupArtifact.AspxApplicationPage", "VirtualHandler.SPLayoutsMappedFile"]
        },
        "applicabilityRuleId": { "type": "string", "minLength": 1 },
        "applicabilityRuleHash": { "$ref": "#/$defs/sha256" },
        "expectedAvailability": {
          "enum": ["AvailableForExactPlatformBuild", "ReferenceTargetAbsentAtFrozenBuild"]
        },
        "downstreamDisposition": { "$ref": "#/$defs/disposition" },
        "identityAxes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestReferenceIdentity",
            "setupArtifactIdentity",
            "virtualHandlerIdentity",
            "ghostedPhysicalFileIdentity"
          ],
          "properties": {
            "requestReferenceIdentity": { "type": "object" },
            "setupArtifactIdentity": { "type": ["object", "null"] },
            "virtualHandlerIdentity": { "type": ["object", "null"] },
            "ghostedPhysicalFileIdentity": { "type": ["object", "null"] }
          }
        },
        "physicalIdentity": { "$ref": "#/$defs/physicalIdentity" },
        "contentOrigin": {
          "enum": [
            "ContentDatabaseCustomized",
            "ContentDatabaseGhosted",
            "SetupArtifact",
            "VirtualHandler",
            "Unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "downstreamDisposition": {
                "enum": ["ReferenceOnlyAvailable", "ReferenceUnavailable", "VirtualHandler"]
              }
            },
            "required": ["downstreamDisposition"]
          },
          "then": {
            "properties": {
              "physicalIdentity": {
                "properties": {
                  "fileUniqueId": { "type": "null" },
                  "physicalLocator": { "type": "null" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
