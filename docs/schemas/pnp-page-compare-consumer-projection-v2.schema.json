{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pnp.github.io/schemas/pnp-page-compare-consumer-projection-v2.schema.json",
  "title": "PnP Page Compare Consumer Projection v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sourceEnvelopeSchemaVersion", "sourceEnvelopeDigestSha256",
    "generatedAtUtc", "canonicalReports", "cases", "projectionDigestSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "pnp-page-compare-consumer-projection/v2" },
    "sourceEnvelopeSchemaVersion": { "const": "pnp-page-compare-terminal-envelope/v2" },
    "sourceEnvelopeDigestSha256": { "$ref": "pnp-page-compare-terminal-envelope-v2.schema.json#/$defs/sha256" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "canonicalReports": {
      "type": "array",
      "items": { "$ref": "pnp-page-compare-report-v1.schema.json" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "terminalKind", "pageFamily", "acceptanceVerdict", "canonicalMaterialRows", "terminal"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "terminalKind": { "type": "string", "minLength": 1 },
          "pageFamily": { "enum": ["classic-wiki", "publishing"] },
          "acceptanceVerdict": { "enum": ["pass", "fail", "conditional", "unverified"] },
          "canonicalMaterialRows": { "type": "array", "items": { "type": "object" } },
          "terminal": { "$ref": "pnp-page-compare-terminal-envelope-v2.schema.json#/$defs/caseWrapper" }
        }
      }
    },
    "projectionDigestSha256": { "$ref": "pnp-page-compare-terminal-envelope-v2.schema.json#/$defs/sha256" }
  }
}
