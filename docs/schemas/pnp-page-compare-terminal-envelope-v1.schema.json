{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pnp.github.io/schemas/pnp-page-compare-terminal-envelope-v1.schema.json",
  "title": "PnP Page Compare Terminal Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAtUtc",
    "canonicalReports",
    "cases",
    "envelopeDigestSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "pnp-page-compare-terminal-envelope/v1" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "canonicalReports": {
      "type": "array",
      "items": { "$ref": "pnp-page-compare-report-v1.schema.json" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/terminalCase" }
    },
    "envelopeDigestSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "operations": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "mutationOperationId",
        "readbackOperationId",
        "runtimeOperationId",
        "cleanupOperationId"
      ],
      "properties": {
        "mutationOperationId": { "type": "string", "format": "uuid" },
        "readbackOperationId": { "type": "string", "format": "uuid" },
        "runtimeOperationId": { "type": "string", "format": "uuid" },
        "cleanupOperationId": { "type": "string", "format": "uuid" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalIdentifier",
        "pageServerRelativeUrl",
        "identityDigestSha256",
        "versionDigestSha256",
        "eTag",
        "lastModifiedUtc",
        "versionLabel",
        "observedAtUtc"
      ],
      "properties": {
        "originalIdentifier": { "type": "string", "minLength": 1 },
        "pageServerRelativeUrl": { "type": "string", "minLength": 1 },
        "identityDigestSha256": { "$ref": "#/$defs/sha256" },
        "versionDigestSha256": { "$ref": "#/$defs/sha256" },
        "eTag": { "type": ["string", "null"] },
        "lastModifiedUtc": { "type": ["string", "null"], "format": "date-time" },
        "versionLabel": { "type": ["string", "null"] },
        "observedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "digestPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawDigestSha256", "canonicalDigestSha256"],
      "properties": {
        "rawDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "canonicalDigestSha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedUrlHashSha256",
        "sourceArtifactDigestSha256",
        "sourceIngredientId",
        "actionId",
        "targetIdentity",
        "evidenceRefs",
        "causeIngredientIds"
      ],
      "properties": {
        "requestedUrlHashSha256": { "$ref": "#/$defs/sha256" },
        "sourceArtifactDigestSha256": { "$ref": "#/$defs/sha256" },
        "sourceIngredientId": { "type": "string", "minLength": 1 },
        "actionId": { "type": ["string", "null"] },
        "targetIdentity": { "type": ["string", "null"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "causeIngredientIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingredientId",
        "kind",
        "subtype",
        "material",
        "required",
        "fidelitySignificant",
        "sourceIdentityDigestSha256",
        "sourceVersionDigestSha256",
        "planDigestSha256",
        "implementationRef",
        "sourceEvidenceDigestSha256",
        "actualEvidenceDigestSha256",
        "actionId",
        "disposition",
        "result",
        "availability",
        "executionStatus",
        "reasonCode",
        "httpStatus",
        "semanticAccessDenied",
        "attemptCount",
        "lineage",
        "expected",
        "actual",
        "dependentObligationIds"
      ],
      "properties": {
        "ingredientId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "subtype": { "type": "string", "minLength": 1 },
        "material": { "type": "boolean" },
        "required": { "type": "boolean" },
        "fidelitySignificant": { "type": "boolean" },
        "sourceIdentityDigestSha256": { "$ref": "#/$defs/sha256" },
        "sourceVersionDigestSha256": { "$ref": "#/$defs/sha256" },
        "planDigestSha256": { "$ref": "#/$defs/sha256" },
        "implementationRef": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceEvidenceDigestSha256": { "$ref": "#/$defs/sha256" },
        "actualEvidenceDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "actionId": { "type": ["string", "null"] },
        "disposition": { "enum": ["Preserve", "Transform", "Drop", "Delegate"] },
        "result": { "type": "string", "minLength": 1 },
        "availability": { "enum": ["captured", "unavailable.access_denied", "unsupported"] },
        "executionStatus": { "enum": ["succeeded", "not-executed"] },
        "reasonCode": { "type": "string", "minLength": 1 },
        "httpStatus": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "semanticAccessDenied": { "type": "boolean" },
        "attemptCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "lineage": { "$ref": "#/$defs/lineage" },
        "expected": { "$ref": "#/$defs/digestPair" },
        "actual": { "$ref": "#/$defs/digestPair" },
        "dependentObligationIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligationId", "ingredientId", "required", "status", "reasonCode"],
      "properties": {
        "obligationId": { "type": "string", "minLength": 1 },
        "ingredientId": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "status": { "enum": ["satisfied", "not-executed", "unverified"] },
        "reasonCode": { "type": "string", "minLength": 1 }
      }
    },
    "terminalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "terminalKind",
        "pageFamily",
        "migrationPackageSchemaVersion",
        "migrationPackageArtifactLocator",
        "migrationPackageArtifactDigestSha256",
        "migrationPackageArtifactLength",
        "source",
        "planDigestSha256",
        "implementationRef",
        "evidenceDigestSha256",
        "admittedPlan",
        "admittedPlanDigestSha256",
        "operations",
        "nativeReceipt",
        "runtimeManifest",
        "runtimeReceipt",
        "runtimeReceiptDigestSha256",
        "mutationStatus",
        "readbackStatus",
        "runtimeStatus",
        "reconcileStatus",
        "reasonCode",
        "ingredients",
        "dependentObligations"
      ],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "terminalKind": {
          "enum": ["wiki-native-executed", "pre-write-denied", "unsupported-no-execution"]
        },
        "pageFamily": { "enum": ["classic-wiki", "publishing"] },
        "migrationPackageSchemaVersion": {
          "enum": [
            "pnp-classic-wiki-page-migration-package/v1",
            "pnp-publishing-page-migration-package/v3"
          ]
        },
        "migrationPackageArtifactLocator": { "type": ["string", "null"] },
        "migrationPackageArtifactDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "migrationPackageArtifactLength": { "type": "integer", "minimum": 0 },
        "source": { "$ref": "#/$defs/source" },
        "planDigestSha256": { "$ref": "#/$defs/sha256" },
        "implementationRef": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "evidenceDigestSha256": { "$ref": "#/$defs/sha256" },
        "admittedPlan": { "type": ["object", "null"] },
        "admittedPlanDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "operations": { "$ref": "#/$defs/operations" },
        "nativeReceipt": { "type": ["object", "null"] },
        "runtimeManifest": { "type": ["object", "null"] },
        "runtimeReceipt": { "type": ["object", "null"] },
        "runtimeReceiptDigestSha256": { "$ref": "#/$defs/nullableSha256" },
        "mutationStatus": { "enum": ["succeeded", "not-executed"] },
        "readbackStatus": { "enum": ["passed", "not-executed"] },
        "runtimeStatus": { "enum": ["passed", "not-executed"] },
        "reconcileStatus": { "enum": ["passed", "partial", "not-executed"] },
        "reasonCode": {
          "enum": ["NATIVE_EXECUTED", "ACCESS_DENIED_SKIPPED", "CAPABILITY_UNSUPPORTED"]
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ingredient" }
        },
        "dependentObligations": {
          "type": "array",
          "items": { "$ref": "#/$defs/obligation" }
        }
      }
    }
  }
}
