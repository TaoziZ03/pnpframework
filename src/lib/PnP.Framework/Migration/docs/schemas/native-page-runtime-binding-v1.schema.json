{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pnp-native-page-runtime-binding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentSha256", "runId", "claimId", "subject", "profileId", "policyVersion", "sourceIdentity", "sourceIdentityEvidence", "sourceVersion", "snapshotDigestSha256", "planDigest", "admittedPlanDigestSha256", "importReceiptDigestSha256", "operations", "targetStorageIdentity", "targetIdentityEvidence", "nativeImportEvidence", "packageEvidence", "policyArtifact", "requirementsManifest", "requirementsManifestDigestSha256", "expectedAuthoredContentSha256", "issuedAtUtc", "captureNotBeforeUtc", "captureExpiresAtUtc", "importProducerRef", "contractProducerRef", "contractProducerProvenanceManifestDigestSha256", "contractProducerProvenanceStatus", "extensions"],
  "properties": {
    "schemaVersion": { "const": "pnp-native-page-runtime-binding/v1" },
    "contentSha256": { "$ref": "#/$defs/sha256" },
    "runId": { "$ref": "#/$defs/guid" },
    "claimId": { "const": "d0a831ec152233e675736e599fb92c04d7a73f7de6402ed50b59b98129d94f53" },
    "subject": { "type": "object", "additionalProperties": false, "required": ["ingredientId", "pageIngredientKind", "subtype", "semanticRole", "primaryOwnerLane", "dependencyIds"], "properties": { "ingredientId": { "const": "node:runtime" }, "pageIngredientKind": { "const": "Runtime" }, "subtype": { "const": "runtime.page" }, "semanticRole": { "const": "runtime.wiki acceptance binding" }, "primaryOwnerLane": { "const": "shared integration" }, "dependencyIds": { "type": "array", "items": { "type": "string" } } } },
    "profileId": { "const": "classic-wiki.synthetic.runtime-acceptance/v1" },
    "policyVersion": { "const": "classic-wiki-runtime-policy/v1" },
    "sourceIdentity": { "$ref": "#/$defs/source" },
    "sourceIdentityEvidence": { "$ref": "#/$defs/sourceEvidence" },
    "sourceVersion": { "type": "object" },
    "snapshotDigestSha256": { "$ref": "#/$defs/sha256" },
    "planDigest": { "$ref": "#/$defs/sha256" },
    "admittedPlanDigestSha256": { "$ref": "#/$defs/sha256" },
    "importReceiptDigestSha256": { "$ref": "#/$defs/sha256" },
    "operations": { "type": "object" },
    "targetStorageIdentity": { "$ref": "#/$defs/target" },
    "targetIdentityEvidence": { "$ref": "#/$defs/identityEvidence" },
    "nativeImportEvidence": { "$ref": "#/$defs/artifact" },
    "packageEvidence": { "$ref": "#/$defs/artifact" },
    "policyArtifact": { "$ref": "#/$defs/artifact" },
    "requirementsManifest": { "type": "object" },
    "requirementsManifestDigestSha256": { "$ref": "#/$defs/sha256" },
    "expectedAuthoredContentSha256": { "$ref": "#/$defs/sha256" },
    "issuedAtUtc": { "type": "string", "format": "date-time" },
    "captureNotBeforeUtc": { "type": "string", "format": "date-time" },
    "captureExpiresAtUtc": { "type": "string", "format": "date-time" },
    "importProducerRef": { "$ref": "#/$defs/gitRef" },
    "contractProducerRef": { "$ref": "#/$defs/gitRef" },
    "contractProducerProvenanceManifestDigestSha256": { "$ref": "#/$defs/sha256" },
    "contractProducerProvenanceStatus": { "enum": ["UNVERIFIED", "VERIFIED", "REJECTED"] },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[^.]+\\..+$" }, "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "gitRef": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "guid": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "source": { "type": "object", "additionalProperties": false, "required": ["siteId", "webId", "listId", "listItemId", "fileUniqueId", "pageServerRelativeUrl"], "properties": { "siteId": { "$ref": "#/$defs/guid" }, "webId": { "$ref": "#/$defs/guid" }, "listId": { "$ref": "#/$defs/guid" }, "listItemId": { "type": "integer", "minimum": 1 }, "fileUniqueId": { "$ref": "#/$defs/guid" }, "pageServerRelativeUrl": { "type": "string", "pattern": "^/" } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["siteId", "webId", "listId", "webUrl", "pageServerRelativeUrl", "fileUniqueId", "listItemId", "listItemVersion", "listItemETag", "canonicalUrl"], "properties": { "siteId": { "$ref": "#/$defs/guid" }, "webId": { "$ref": "#/$defs/guid" }, "listId": { "$ref": "#/$defs/guid" }, "webUrl": { "type": "string", "format": "uri" }, "pageServerRelativeUrl": { "type": "string", "pattern": "^/" }, "fileUniqueId": { "$ref": "#/$defs/guid" }, "listItemId": { "type": "integer", "minimum": 1 }, "listItemVersion": { "type": "string", "minLength": 1 }, "listItemETag": { "type": "string", "minLength": 1 }, "canonicalUrl": { "type": "string", "format": "uri" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["sha256", "length", "mediaType", "locator"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "length": { "type": "integer", "minimum": 1 }, "mediaType": { "type": "string", "minLength": 1 }, "locator": { "type": "string", "pattern": "^[0-9a-f]{2}/[0-9a-f]{64}$" } } },
    "sourceEvidence": { "type": "object", "additionalProperties": false, "required": ["observationId", "observedAtUtc", "operationId", "acquisitionMethod", "providerId", "providerVersion", "sourceVersionDigestSha256", "identity", "artifact"], "properties": { "observationId": { "type": "string", "minLength": 1 }, "observedAtUtc": { "type": "string", "format": "date-time" }, "operationId": { "$ref": "#/$defs/guid" }, "acquisitionMethod": { "type": "string", "minLength": 1 }, "providerId": { "type": "string", "minLength": 1 }, "providerVersion": { "type": "string", "minLength": 1 }, "sourceVersionDigestSha256": { "$ref": "#/$defs/sha256" }, "identity": { "$ref": "#/$defs/source" }, "artifact": { "$ref": "#/$defs/artifact" } } },
    "identityEvidence": { "type": "object", "additionalProperties": false, "required": ["observationId", "observedAtUtc", "operationId", "providerId", "providerVersion", "sourceArtifactSha256", "identity", "artifact"], "properties": { "observationId": { "type": "string", "minLength": 1 }, "observedAtUtc": { "type": "string", "format": "date-time" }, "operationId": { "$ref": "#/$defs/guid" }, "providerId": { "type": "string", "minLength": 1 }, "providerVersion": { "type": "string", "minLength": 1 }, "sourceArtifactSha256": { "$ref": "#/$defs/sha256" }, "identity": { "$ref": "#/$defs/target" }, "artifact": { "$ref": "#/$defs/artifact" } } }
  }
}
