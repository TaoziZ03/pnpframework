{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pnp.github.io/schemas/migration/native-page-runtime-acceptance-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentSha256", "evaluatedAtUtc", "evaluatorId", "evaluatorImplementationRef", "runId", "claimId", "subject", "packageDigestSha256", "snapshotDigestSha256", "admittedPlanDigestSha256", "importReceiptDigestSha256", "bindingDigestSha256", "externalEvidenceDigestSha256", "producerBuildProvenanceReceiptDigestSha256", "bindingValidationStatus", "storageVerificationStatus", "runtimeVerificationStatus", "acceptanceStatus", "provenanceStatus", "explicitExclusions", "reasonCodes", "evidenceReferences", "extensions"],
  "properties": {
    "schemaVersion": { "const": "pnp-native-page-runtime-acceptance-receipt/v1" },
    "contentSha256": { "$ref": "#/$defs/sha256" },
    "evaluatedAtUtc": { "$ref": "#/$defs/dateTime" },
    "evaluatorId": { "type": ["string", "null"], "minLength": 1 },
    "evaluatorImplementationRef": { "anyOf": [{ "$ref": "#/$defs/gitRef" }, { "type": "null" }] },
    "runId": { "type": "string", "format": "uuid" },
    "claimId": { "type": ["string", "null"] },
    "subject": { "anyOf": [{ "$ref": "#/$defs/subject" }, { "type": "null" }] },
    "packageDigestSha256": { "$ref": "#/$defs/nullableSha256" },
    "snapshotDigestSha256": { "$ref": "#/$defs/nullableSha256" },
    "admittedPlanDigestSha256": { "$ref": "#/$defs/nullableSha256" },
    "importReceiptDigestSha256": { "$ref": "#/$defs/nullableSha256" },
    "bindingDigestSha256": { "$ref": "#/$defs/nullableSha256" },
    "externalEvidenceDigestSha256": { "$ref": "#/$defs/nullableSha256" },
    "producerBuildProvenanceReceiptDigestSha256": { "$ref": "#/$defs/nullableSha256" },
    "bindingValidationStatus": { "enum": ["Valid", "Incomplete", "Invalid"] },
    "storageVerificationStatus": { "enum": ["NotRun", "Passed", "Failed"] },
    "runtimeVerificationStatus": { "enum": ["NotRun", "NotRequired", "Pending", "Passed", "Failed"] },
    "acceptanceStatus": { "enum": ["Pending", "Accepted", "Rejected", "PartiallyAccepted"] },
    "provenanceStatus": { "enum": ["UNVERIFIED", "VERIFIED", "REJECTED"] },
    "explicitExclusions": { "type": "boolean" },
    "reasonCodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidenceReferences": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[^.]+\\..+$" }, "additionalProperties": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "bindingValidationStatus": { "const": "Valid" } } },
      "then": {
        "properties": {
          "claimId": { "const": "d0a831ec152233e675736e599fb92c04d7a73f7de6402ed50b59b98129d94f53" },
          "evaluatorId": { "type": "string", "minLength": 1 },
          "evaluatorImplementationRef": { "$ref": "#/$defs/gitRef" },
          "subject": { "$ref": "#/$defs/subject" },
          "packageDigestSha256": { "$ref": "#/$defs/sha256" },
          "snapshotDigestSha256": { "$ref": "#/$defs/sha256" },
          "admittedPlanDigestSha256": { "$ref": "#/$defs/sha256" },
          "importReceiptDigestSha256": { "$ref": "#/$defs/sha256" },
          "bindingDigestSha256": { "$ref": "#/$defs/sha256" },
          "externalEvidenceDigestSha256": { "$ref": "#/$defs/sha256" },
          "producerBuildProvenanceReceiptDigestSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    {
      "if": { "properties": { "runtimeVerificationStatus": { "const": "Passed" } } },
      "then": { "properties": { "bindingValidationStatus": { "const": "Valid" }, "acceptanceStatus": { "enum": ["Accepted", "PartiallyAccepted"] }, "provenanceStatus": { "const": "VERIFIED" } } }
    },
    {
      "if": { "properties": { "runtimeVerificationStatus": { "const": "Failed" } } },
      "then": { "properties": { "bindingValidationStatus": { "const": "Valid" }, "acceptanceStatus": { "const": "Rejected" } } }
    },
    {
      "if": { "properties": { "acceptanceStatus": { "const": "Pending" } } },
      "then": { "properties": { "runtimeVerificationStatus": { "enum": ["Pending", "NotRun", "NotRequired"] } } }
    },
    {
      "if": { "properties": { "acceptanceStatus": { "enum": ["Accepted", "PartiallyAccepted"] } } },
      "then": { "properties": { "bindingValidationStatus": { "const": "Valid" }, "runtimeVerificationStatus": { "const": "Passed" }, "provenanceStatus": { "const": "VERIFIED" }, "producerBuildProvenanceReceiptDigestSha256": { "$ref": "#/$defs/sha256" } } }
    },
    {
      "if": { "properties": { "acceptanceStatus": { "const": "Rejected" } } },
      "then": { "properties": { "bindingValidationStatus": { "const": "Valid" }, "runtimeVerificationStatus": { "const": "Failed" } } }
    },
    {
      "if": { "properties": { "provenanceStatus": { "enum": ["VERIFIED", "REJECTED"] } } },
      "then": { "properties": { "producerBuildProvenanceReceiptDigestSha256": { "$ref": "#/$defs/sha256" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "nullableSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "gitRef": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "guid": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "dateTime": { "type": "string", "format": "date-time" },
    "safeLocator": { "type": "string", "minLength": 1, "pattern": "^(?![/\\\\])(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$)).+" },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["ingredientId", "pageIngredientKind", "subtype", "semanticRole", "primaryOwnerLane", "dependencyIds"],
      "properties": { "ingredientId": { "const": "node:runtime" }, "pageIngredientKind": { "const": "Runtime" }, "subtype": { "const": "runtime.page" }, "semanticRole": { "const": "runtime.wiki acceptance binding" }, "primaryOwnerLane": { "const": "shared integration" }, "dependencyIds": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "length", "mediaType", "locator"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "length": { "type": "integer", "minimum": 1 }, "mediaType": { "type": "string", "minLength": 1 }, "locator": { "$ref": "#/$defs/safeLocator" } }
    }
  }
}
