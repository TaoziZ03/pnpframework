{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pnp-native-page-runtime-acceptance-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentSha256", "evaluatedAtUtc", "evaluatorId", "evaluatorImplementationRef", "runId", "claimId", "subject", "packageDigestSha256", "snapshotDigestSha256", "admittedPlanDigestSha256", "importReceiptDigestSha256", "bindingDigestSha256", "externalEvidenceDigestSha256", "producerBuildProvenanceReceiptDigestSha256", "bindingValidationStatus", "storageVerificationStatus", "runtimeVerificationStatus", "acceptanceStatus", "provenanceStatus", "explicitExclusions", "reasonCodes", "evidenceReferences", "extensions"],
  "properties": {
    "schemaVersion": { "const": "pnp-native-page-runtime-acceptance-receipt/v1" },
    "contentSha256": { "$ref": "#/$defs/sha256" },
    "evaluatedAtUtc": { "type": "string", "format": "date-time" },
    "evaluatorId": { "type": "string", "minLength": 1 },
    "evaluatorImplementationRef": { "$ref": "#/$defs/gitRef" },
    "runId": { "$ref": "#/$defs/guid" },
    "claimId": { "type": "string", "minLength": 1 },
    "subject": { "type": "object" },
    "packageDigestSha256": { "$ref": "#/$defs/sha256" },
    "snapshotDigestSha256": { "$ref": "#/$defs/sha256" },
    "admittedPlanDigestSha256": { "$ref": "#/$defs/sha256" },
    "importReceiptDigestSha256": { "$ref": "#/$defs/sha256" },
    "bindingDigestSha256": { "$ref": "#/$defs/sha256" },
    "externalEvidenceDigestSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "producerBuildProvenanceReceiptDigestSha256": { "$ref": "#/$defs/sha256" },
    "bindingValidationStatus": { "enum": ["Valid", "Incomplete", "Invalid"] },
    "storageVerificationStatus": { "enum": ["NotRun", "Passed", "Failed"] },
    "runtimeVerificationStatus": { "enum": ["NotRun", "NotRequired", "Pending", "Passed", "Failed"] },
    "acceptanceStatus": { "enum": ["Pending", "Accepted", "Rejected", "PartiallyAccepted"] },
    "provenanceStatus": { "enum": ["UNVERIFIED", "VERIFIED", "REJECTED"] },
    "explicitExclusions": { "type": "boolean" },
    "reasonCodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidenceReferences": { "type": "array", "items": { "$ref": "native-page-runtime-binding-v1.schema.json#/$defs/artifact" } },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[^.]+\\..+$" }, "additionalProperties": { "type": "string" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }, "gitRef": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }, "guid": { "type": "string", "format": "uuid" } }
}
