{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pnp-external-page-runtime-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentSha256", "runId", "claimId", "bindingDigestSha256", "captureProducer", "profileClass", "startedAtUtc", "completedAtUtc", "resultKind", "observedTargetIdentity", "preCaptureTargetReadback", "postCaptureTargetReadback", "attempts", "artifactManifest", "runtimeReceipt", "runtimeReceiptDigestSha256", "terminalObservation", "extensions"],
  "properties": {
    "schemaVersion": { "const": "pnp-external-page-runtime-evidence/v1" },
    "contentSha256": { "$ref": "#/$defs/sha256" },
    "runId": { "$ref": "#/$defs/guid" },
    "claimId": { "const": "d0a831ec152233e675736e599fb92c04d7a73f7de6402ed50b59b98129d94f53" },
    "bindingDigestSha256": { "$ref": "#/$defs/sha256" },
    "captureProducer": { "type": "object", "additionalProperties": false, "required": ["adapterId", "version", "implementationRef", "toolVersion", "protocolVersion"], "properties": { "adapterId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "implementationRef": { "$ref": "#/$defs/gitRef" }, "toolVersion": { "type": "string", "minLength": 1 }, "protocolVersion": { "type": "string", "minLength": 1 } } },
    "profileClass": { "const": "classic-wiki.synthetic.runtime-acceptance/v1" },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": { "type": "string", "format": "date-time" },
    "resultKind": { "enum": ["runtime-receipt", "terminal-observation"] },
    "observedTargetIdentity": { "$ref": "native-page-runtime-binding-v1.schema.json#/$defs/target" },
    "preCaptureTargetReadback": { "$ref": "native-page-runtime-binding-v1.schema.json#/$defs/identityEvidence" },
    "postCaptureTargetReadback": { "$ref": "native-page-runtime-binding-v1.schema.json#/$defs/identityEvidence" },
    "attempts": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object" } },
    "artifactManifest": { "type": "object" },
    "runtimeReceipt": { "type": ["object", "null"] },
    "runtimeReceiptDigestSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "terminalObservation": { "type": ["object", "null"] },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[^.]+\\..+$" }, "additionalProperties": { "type": "string" } }
  },
  "oneOf": [
    { "properties": { "resultKind": { "const": "runtime-receipt" }, "runtimeReceipt": { "type": "object" }, "runtimeReceiptDigestSha256": { "$ref": "#/$defs/sha256" }, "terminalObservation": { "type": "null" } } },
    { "properties": { "resultKind": { "const": "terminal-observation" }, "runtimeReceipt": { "type": "null" }, "runtimeReceiptDigestSha256": { "type": "null" }, "terminalObservation": { "type": "object" } } }
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }, "gitRef": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }, "guid": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } } }
}
